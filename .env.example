# Copy only the variables needed by the services you run.
# Never commit a populated .env file.

DB_URL=YOUR_DATABASE_URL
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=GENERATE_A_STRONG_SECRET
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=YOUR_INTERNAL_AI_SERVICE_TOKEN
VITE_API_BASE_URL=YOUR_BACKEND_API_URL
MODEL_PATH=YOUR_MODEL_PATH
INTERNAL_API_TOKEN=YOUR_INTERNAL_API_TOKEN

# FR-11, FR-28: Payment Gateway Credentials (VNPay & MoMo)
PAYMENT_SANDBOX_MODE=true
VNPAY_TMN_CODE=YOUR_VNPAY_MERCHANT_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET_KEY
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-callback

MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/payment/momo-callback