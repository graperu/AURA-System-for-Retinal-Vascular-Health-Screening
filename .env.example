POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_CORE_PORT=8000
VITE_BACKEND_API_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

# Chạy Spring Boot trực tiếp ngoài Docker
DATABASE_URL=jdbc:postgresql://localhost:5432/aura
DATABASE_USERNAME=aura
DATABASE_PASSWORD=aura_dev_password
AI_CORE_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth (FR-1, FR-32, NFR-12)
# Generate a real value with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-this-is-not-a-secure-secret-key-32bytes+
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google social login (FR-1). Leave blank to disable Google login locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_FRONTEND_REDIRECT=http://localhost:5173/oauth2/callback
